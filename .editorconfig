# Keeps editors consistent with what Spotless (google-java-format) enforces in CI.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Generated by Spring Initializr with tabs; kept as-is to avoid a noisy reformat.
[pom.xml]
indent_style = tab
indent_size = 4

[*.cmd]
end_of_line = crlf

# Trailing double spaces are meaningful line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
