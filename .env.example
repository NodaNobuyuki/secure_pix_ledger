# Copy to .env and replace every value. .env is git-ignored; never commit real credentials.
# All data in this project is synthetic.

POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me

# The least-privilege role the app connects as; the POSTGRES_* owner above only runs migrations.
# Created when the database volume is first initialized (`docker compose down -v` to recreate).
APP_DB_USER=bank_app
APP_DB_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Uncomment both to seed demo users alice and bob, each owning a funded account (synthetic money;
# see DemoDataSeeder). The password is required with dev, 12 to 128 characters.
# SPRING_PROFILES_ACTIVE=dev
# DEMO_USER_PASSWORD=change-me-too
